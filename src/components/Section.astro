---
export interface Props {
  title: string;
  description?: string;
  descriptionClass?: string;
  eyebrow?: string;
  headerClass?: string;
  class?: string;
}

const {
  title,
  description,
  descriptionClass = "text-muted text-lg leading-relaxed",
  eyebrow,
  headerClass = "max-w-5xl mx-auto px-4 text-center mb-16",
  class: className,
} = Astro.props;
---

<section class:list={["py-48", className]}>
  <div class={headerClass}>
    {eyebrow && (
      <p class="text-xs tracking-[0.25em] uppercase text-muted mb-4">{eyebrow}</p>
    )}
    <h2 class="text-5xl md:text-6xl font-bold text-paper mb-4">{title}</h2>
    {description && <p class:list={[descriptionClass]}>{description}</p>}
    <slot name="header" />
  </div>
  <slot />
</section>
