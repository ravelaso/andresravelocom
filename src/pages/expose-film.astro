---
import Layout from "@/layouts/Layout.astro";
import NavBar from "@/components/NavBar";
import Hero from "@/components/Hero.astro";
import FilmStrip from "@/components/FilmStrip.astro";
import ExposeFeature from "@/components/ExposeFeature.astro";
import ExposeLibrary from "@/components/ExposeLibrary.astro";
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import { getCollection, type CollectionEntry } from "astro:content";

export const prerender = true;

type ExposeData = CollectionEntry<"exposeFilm">["data"];

const isHero = (d: ExposeData): d is Extract<ExposeData, { type: "hero" }> =>
    d.type === "hero";
const isFeature = (d: ExposeData): d is Extract<ExposeData, { type: "feature" }> =>
    d.type === "feature";
const isLibrary = (d: ExposeData): d is Extract<ExposeData, { type: "library" }> =>
    d.type === "library";
const isPhilosophy = (d: ExposeData): d is Extract<ExposeData, { type: "philosophy" }> =>
    d.type === "philosophy";

const entries = await getCollection("exposeFilm");
const data = entries.map((e) => e.data);

const hero = data.find(isHero)!;
const features = data.filter(isFeature);
const library = data.find(isLibrary)!;
const philosophy = data.find(isPhilosophy)!;

const imageModules = import.meta.glob<{ default: ImageMetadata }>(
    "/src/assets/expose-film/*.{jpg,jpeg,png,webp}",
    { eager: true },
);
const images = Object.values(imageModules).map((mod) => mod.default);
---

<Layout title="Expose Film — Andres Ravelo">
    <NavBar client:only="react" />

    <main>
        <FilmStrip class="mt-8 md:mt-14" />

        <Hero eyebrow={hero.eyebrow} title={hero.title} description={hero.description}>
            <div class="flex flex-wrap justify-center gap-2">
                {hero.badges.map((badge) => (
                    <span class="bg-surface-2 text-body text-sm px-3 py-1 rounded-full border border-line">
                        {badge}
                    </span>
                ))}
            </div>
            <p class="text-muted text-sm">Coming soon to iOS &amp; Android</p>
        </Hero>

        <FilmStrip />

        {images.length > 0 && (
            <>
                <section class="py-24">
                    <div class="max-w-5xl mx-auto px-4">
                        <div class="rounded-lg overflow-hidden border border-line bg-ink-2">
                            <div class="flex overflow-x-auto space-x-4 p-4">
                                {images.map((image) => (
                                    <div class="flex-none w-64 h-64 md:w-96 md:h-96">
                                        <Image
                                            src={image}
                                            alt="Expose Film screenshot"
                                            class="w-full h-full object-contain rounded-lg"
                                            format="webp"
                                            sizes="(max-width: 768px) 100vw, 768px"
                                        />
                                    </div>
                                ))}
                            </div>
                        </div>
                    </div>
                </section>
                <FilmStrip />
            </>
        )}

        {features.map((feature) => (
            <>
                <ExposeFeature feature={feature} />
                <FilmStrip />
            </>
        ))}

        <ExposeLibrary library={library} />

        <FilmStrip />

        <section class="py-48">
            <div class="max-w-3xl mx-auto px-4 text-center">
                <h2 class="text-5xl md:text-6xl font-bold text-paper mb-6">{philosophy.title}</h2>
                <p class="text-body text-lg md:text-xl leading-relaxed">{philosophy.text}</p>
            </div>
        </section>
    </main>
</Layout>
