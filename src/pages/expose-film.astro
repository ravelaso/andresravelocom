---
import Layout from "@/layouts/Layout.astro";
import NavBar from "@/components/NavBar";
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

export const prerender = true;

const imageModules = import.meta.glob<{ default: ImageMetadata }>(
    "/src/assets/expose-film/*.{jpg,jpeg,png,webp}",
    { eager: true },
);
const images = Object.values(imageModules).map((mod) => mod.default);
---

<Layout title="Expose Film — Andres Ravelo">
    <NavBar client:only="react" />

    <main class="max-w-4xl mx-auto px-4 py-20 text-neutral-100">

        <!-- Hero -->
        <section class="py-16 md:py-24">
            <div class="max-w-3xl">
                <p class="text-xs tracking-[0.25em] uppercase text-neutral-500 mb-4">Mobile App</p>
                <h1 class="text-5xl md:text-6xl font-bold text-white mb-6">Expose Film</h1>
                <p class="text-lg md:text-xl text-gray-400 leading-relaxed">
                    A digital companion for analog photographers. Meter light, track your rolls,
                    and master the darkroom — from exposure to development.
                </p>

                <div class="flex flex-wrap gap-2 mt-6">
                    {["iOS", "Android"].map((tech) => (
                        <span class="bg-neutral-800 text-neutral-300 text-sm px-3 py-1 rounded-full border border-neutral-700">
                            {tech}
                        </span>
                    ))}
                </div>

                <div class="mt-8 flex flex-wrap gap-4 items-center">
                    <a
                        href="https://github.com/ravelaso/expose-film"
                        class="inline-flex items-center gap-2 px-6 py-3 bg-neutral-100 text-black font-semibold rounded-xl hover:bg-neutral-200 transition"
                    >
                        See on GitHub
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                        </svg>
                    </a>
                    <span class="text-neutral-600 text-sm">Coming soon to iOS &amp; Android</span>
                </div>
            </div>
        </section>

        <!-- Screenshots -->
        {images.length > 0 && (
        <div class="mb-20 rounded-lg overflow-hidden border border-neutral-800">
            <div class="flex overflow-x-auto space-x-4 p-4 bg-neutral-900 rounded-lg">
                {images.map((image) => (
                    <div class="flex-none w-64 h-64 md:w-96 md:h-96">
                        <Image
                            src={image}
                            alt="Expose Film screenshot"
                            class="w-full h-full object-contain rounded-lg"
                            format="webp"
                            sizes="(max-width: 768px) 100vw, 768px"
                        />
                    </div>
                ))}
            </div>
        </div>
        )}

        <!-- Light Meter -->
        <section class="py-16 border-t border-neutral-900">
            <div class="grid md:grid-cols-2 gap-12 items-center">
                <div>
                    <p class="text-xs tracking-[0.25em] uppercase text-neutral-500 mb-4">Feature</p>
                    <h2 class="text-3xl md:text-4xl font-bold text-white mb-6">Light Meter</h2>
                    <p class="text-gray-400 text-lg leading-relaxed mb-6">
                        Use your phone's camera to measure ambient light and get accurate
                        exposure values for your film camera.
                    </p>

                    <div class="space-y-4">
                        <div class="flex items-start gap-3">
                            <span class="text-green-400 flex-shrink-0 mt-1">✓</span>
                            <p class="text-gray-300"><strong class="text-white">One-tap metering</strong> — point, capture, and get your aperture, shutter speed, and ISO</p>
                        </div>
                        <div class="flex items-start gap-3">
                            <span class="text-green-400 flex-shrink-0 mt-1">✓</span>
                            <p class="text-gray-300"><strong class="text-white">Lock what matters</strong> — lock aperture, shutter, or ISO while the app adjusts the rest</p>
                        </div>
                        <div class="flex items-start gap-3">
                            <span class="text-green-400 flex-shrink-0 mt-1">✓</span>
                            <p class="text-gray-300"><strong class="text-white">Film mode</strong> — lock to your film stock's ISO, control aperture and shutter freely</p>
                        </div>
                        <div class="flex items-start gap-3">
                            <span class="text-green-400 flex-shrink-0 mt-1">✓</span>
                            <p class="text-gray-300"><strong class="text-white">ΔEV indicator</strong> — see at a glance if you're over or underexposed relative to your reference</p>
                        </div>
                    </div>
                </div>

                <div class="bg-neutral-900/50 border border-neutral-800 rounded-2xl p-8">
                    <div class="text-5xl mb-4 text-center">📸</div>
                    <p class="text-gray-400 text-sm text-center leading-relaxed">
                        Point your phone, read the light, transfer the settings to your camera.
                        No guesswork, no separate meter.
                    </p>
                    <div class="mt-6 flex justify-center gap-6 text-center text-sm">
                        <div>
                            <p class="text-white font-semibold text-lg">3</p>
                            <p class="text-neutral-500">Lock modes</p>
                        </div>
                        <div class="w-px bg-neutral-800" />
                        <div>
                            <p class="text-white font-semibold text-lg">1/3</p>
                            <p class="text-neutral-500">Stop precision</p>
                        </div>
                        <div class="w-px bg-neutral-800" />
                        <div>
                            <p class="text-white font-semibold text-lg">0.17</p>
                            <p class="text-neutral-500">Max quant error</p>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Roll Management -->
        <section class="py-16 border-t border-neutral-900">
            <div class="grid md:grid-cols-2 gap-12 items-center">
                <div class="order-2 md:order-1 bg-neutral-900/50 border border-neutral-800 rounded-2xl p-8">
                    <div class="text-5xl mb-4 text-center">🎞️</div>
                    <p class="text-gray-400 text-sm text-center leading-relaxed">
                        Every roll, every frame, every setting — all in one place.
                        Never guess what you shot or how you metered it.
                    </p>
                </div>

                <div class="order-1 md:order-2">
                    <p class="text-xs tracking-[0.25em] uppercase text-neutral-500 mb-4">Feature</p>
                    <h2 class="text-3xl md:text-4xl font-bold text-white mb-6">Roll Management</h2>
                    <p class="text-gray-400 text-lg leading-relaxed mb-6">
                        Keep a memorandum of every exposure across every roll you shoot.
                    </p>

                    <div class="space-y-4">
                        <div class="flex items-start gap-3">
                            <span class="text-green-400 flex-shrink-0 mt-1">✓</span>
                            <p class="text-gray-300"><strong class="text-white">Active, completed, developed</strong> — three states to track each roll's journey</p>
                        </div>
                        <div class="flex items-start gap-3">
                            <span class="text-green-400 flex-shrink-0 mt-1">✓</span>
                            <p class="text-gray-300"><strong class="text-white">Frame-by-frame log</strong> — every metered exposure saves camera settings for later reference</p>
                        </div>
                        <div class="flex items-start gap-3">
                            <span class="text-green-400 flex-shrink-0 mt-1">✓</span>
                            <p class="text-gray-300"><strong class="text-white">Film stock &amp; format</strong> — see at a glance what's loaded, what format, and how many frames left</p>
                        </div>
                        <div class="flex items-start gap-3">
                            <span class="text-green-400 flex-shrink-0 mt-1">✓</span>
                            <p class="text-gray-300"><strong class="text-white">Exposure progress</strong> — visual indicator of how many frames you've exposed</p>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Features in Development -->
        <section class="py-16 border-t border-neutral-900">
            <p class="text-xs tracking-[0.25em] uppercase text-neutral-500 mb-4">In Development</p>
            <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">Expanding Library</h2>
            <p class="text-gray-400 text-lg mb-10 max-w-2xl leading-relaxed">
                A growing collection of film data and darkroom tools, all built into the app.
            </p>

            <div class="grid md:grid-cols-2 gap-6">
                <div class="bg-neutral-900/50 border border-neutral-800 rounded-2xl p-6">
                    <div class="flex items-start gap-4">
                        <span class="text-2xl flex-shrink-0">📊</span>
                        <div>
                            <h3 class="text-lg font-semibold text-white mb-2">Film database</h3>
                            <p class="text-gray-400 text-sm leading-relaxed">
                                Reciprocity failure data for 20+ film stocks from Fuji, Kodak, Ilford, Foma, and
                                more. Know exactly how much to compensate for long exposures.
                            </p>
                        </div>
                    </div>
                </div>

                <div class="bg-neutral-900/50 border border-neutral-800 rounded-2xl p-6">
                    <div class="flex items-start gap-4">
                        <span class="text-2xl flex-shrink-0">📖</span>
                        <div>
                            <h3 class="text-lg font-semibold text-white mb-2">Developer recipes</h3>
                            <p class="text-gray-400 text-sm leading-relaxed">
                                Curated database of film + developer combinations with real-world agitation
                                patterns sourced from the community.
                            </p>
                        </div>
                    </div>
                </div>

                <div class="bg-neutral-900/50 border border-neutral-800 rounded-2xl p-6">
                    <div class="flex items-start gap-4">
                        <span class="text-2xl flex-shrink-0">⏱️</span>
                        <div>
                            <h3 class="text-lg font-semibold text-white mb-2">Dev time calculator</h3>
                            <p class="text-gray-400 text-sm leading-relaxed">
                                Enter your film and developer combination — get development times adjusted
                                for temperature and dilution.
                            </p>
                        </div>
                    </div>
                </div>

                <div class="bg-neutral-900/50 border border-neutral-800 rounded-2xl p-6">
                    <div class="flex items-start gap-4">
                        <span class="text-2xl flex-shrink-0">🧪</span>
                        <div>
                            <h3 class="text-lg font-semibold text-white mb-2">Chemical mixing</h3>
                            <p class="text-gray-400 text-sm leading-relaxed">
                                Precise ratios for your developer, stop bath, and fixer. No more math
                                at the sink.
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Philosophy -->
        <section class="py-16 border-t border-neutral-900">
            <div class="max-w-2xl mx-auto text-center">
                <h2 class="text-3xl md:text-4xl font-bold text-white mb-6">Why Expose Film?</h2>
                <p class="text-gray-400 text-lg leading-relaxed">
                    Built for photographers who want full control over their process — from metering
                    light at the scene to dialing in the perfect development recipe in the darkroom.
                    Whether you're new to film or a seasoned professional, Expose Film helps you
                    learn, track, and improve your workflow.
                </p>
            </div>
        </section>

        <!-- Footer -->
        <footer class="py-12 border-t border-neutral-900 text-center">
            <p class="text-neutral-500 italic">Built with <span class="text-red-400">🖤</span> for the analog community.</p>
        </footer>

    </main>
</Layout>
