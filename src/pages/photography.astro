---
import Layout from "@/layouts/Layout.astro";
import NavBar from "@/components/NavBar";
import PhotoGallery from "@/components/PhotoGallery";
import FilmStripCard from "@/components/FilmStripCard.astro";
import type { ApiResponseData } from "@/lib/useGallery";

import { getCollection } from "astro:content";

export const prerender = false;

// Load initial data on server-side
let initialData: ApiResponseData = {
    images: [],
    hasMore: false,
    cursor: null,
    total: 0,
    tags: [],
    collections: [],
    featured: [],
};

try {
    const response = await fetch(new URL("/api/photos?limit=12", Astro.url));
    if (response.ok) {
        initialData = await response.json();
    }
} catch (error) {
    console.error("Error loading initial images:", error);
}

const aboutContent = await getCollection(
    "photography",
    (entry: { data: { type: string; }; }) => entry.data.type === "about",
);
const about = aboutContent[0];
---

<Layout>
    <NavBar client:only="react" />

    <FilmStripCard
        title={about.data.title}
        description={about.data.description}
    />

    <!-- Gallery Heading -->
    <h2
        class="text-3xl md:text-4xl font-bold text-center text-white mt-24 mb-8"
    >
        Image Gallery
    </h2>

    <!-- Gallery Component -->
    <PhotoGallery client:only="react" initialData={initialData} />
</Layout>
