---
import Layout from "@/layouts/Layout.astro";
import NavBar from "@/components/NavBar";
import PhotoGallery from "@/components/PhotoGallery";
import type { ApiResponseData } from "@/lib/useGallery";

export const prerender = false;

let initialData: ApiResponseData = {
    images: [],
    hasMore: false,
    cursor: null,
    total: 0,
    tags: [],
    collections: [],
    featured: [],
};

try {
    const response = await fetch(new URL("/api/photos?limit=12", Astro.url));
    if (response.ok) {
        initialData = await response.json();
    }
} catch (error) {
    console.error("Error loading initial images:", error);
}
---

<Layout title="Gallery — Andres Ravelo">
    <NavBar client:only="react" />

    <div>
        <h1 class="text-4xl md:text-5xl font-bold text-center text-white pt-28 pb-2">Gallery</h1>
        <p class="text-gray-400 text-center mb-4 text-lg">All photos shot on film unless noted</p>
    </div>

    <PhotoGallery client:only="react" initialData={initialData} />
</Layout>